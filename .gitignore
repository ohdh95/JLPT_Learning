# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Downloaded source archives and generated developer caches
downloads/
.venv-localization/
*.building.sqlite
__pycache__/
*.pyc
reports/*retry*.log

# Published binaries belong in GitHub Releases, not source history.
/dist/
*.apk
*.aab
*.apk.zip

# Private signing material and user data must never enter public source/ZIPs.
key.properties
*.jks
*.keystore
*.p12
*.pem
.env
.env.*
user.db*
*user-backup*.json
/backups/

# Local input attachments, translation caches and device-session evidence.
/reference/
*.cache.jsonl
/reports/android/
/reports/*-screens/
/reports/*-install.json
/reports/*-ui.json
/reports/*-live-flags.json
/reports/*-v1-migration.json
/reports/emulator-start.png
/reports/artifacts.json
